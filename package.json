{
  "name": "codemoot",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean",
    "workflow:controller": "node tools/review-controller/controller.mjs",
    "workflow:status": "node tools/review-controller/controller.mjs status",
    "workflow:run-once": "node tools/review-controller/controller.mjs run-once",
    "workflow:run": "node tools/review-controller/controller.mjs run-until-stop",
    "workflow:test": "node --test tools/review-controller/tests/*.test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "@vitest/coverage-v8": "^3.0.0"
  },
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "pnpm": "9.15.9"
  }
}
