{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "implementation-report.schema.json",
  "title": "Review-gated batch implementation report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workflowId",
    "batchId",
    "reportComplete",
    "approvedPlanPath",
    "baseSha",
    "resultingHeadSha",
    "filesChanged",
    "scopeCompliance",
    "acceptanceCriteria",
    "verification",
    "deferredWork",
    "summary"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "workflowId": { "type": "string", "minLength": 1 },
    "batchId": { "type": "integer", "minimum": 1 },
    "reportComplete": { "const": true },
    "approvedPlanPath": { "type": "string", "minLength": 1 },
    "baseSha": { "type": "string", "minLength": 1 },
    "resultingHeadSha": { "type": "string", "minLength": 1 },
    "filesChanged": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "scopeCompliance": { "oneOf": [{ "type": "boolean" }, { "type": "object" }] },
    "acceptanceCriteria": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "verification": { "oneOf": [{ "type": "array" }, { "type": "object" }] },
    "deferredWork": { "type": "array" },
    "summary": { "type": "string", "minLength": 1 }
  }
}
